LOG_FILTER=info # trace, debug, info, warn, error
# Bind unique address for HTTP + gRPC + SQL 
INFLUXDB3_HTTP_BIND_ADDR=0.0.0.0:8181
# Root datas (catalog, parquet, wal, etc.)
INFLUXDB3_DB_DIR=/var/lib/influxdb
# Object store (Parquet)
INFLUXDB3_OBJECT_STORE=file
INFLUXDB3_PLUGIN_DIR=/etc/influxdb/plugins
INFLUXDB3_NODE_IDENTIFIER_PREFIX=node1
# Additional entry point settings
INFLUXDB3_DATABASE_NAME=measurements
INFLUXDB3_DATABASE_RETENTION=1h
INFLUXDB3_HOST=0.0.0.0
INFLUXDB3_PORT=8181
INFLUXDB3_HTTP_PROTO=http