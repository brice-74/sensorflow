INFLUXDB_LOG_LEVEL=info # info, debug, warn, error
# Bind addresses
INFLUXDB_BIND_ADDRESS=0.0.0.0:8181
INFLUXDB_HTTP_BIND_ADDRESS=0.0.0.0:8181
INFLUXDB_GRPC_BIND_ADDRESS=0.0.0.0:8181
# Root dir
INFLUXDB_DB_DIR=/var/lib/influxdb 
# Main datas
INFLUXDB_DATA_DIR=/var/lib/influxdb/data 
# Write-Ahead Log
INFLUXDB_WAL_DIR=/var/lib/influxdb/wal 
INFLUXDB_CATALOG_DIR=/var/lib/influxdb/catalog
INFLUXDB_PARQUET_DIR=/var/lib/influxdb/parquet
# Object store (Parquet)
INFLUXDB_OBJECT_STORE=file # file, memory, aws, gcp, azure
INFLUXDB_OBJECT_STORE_PATH=/var/lib/influxdb/objstore
# Init user
INFLUXDB_INITIAL_USER=admin 
INFLUXDB_INITIAL_PASSWORD=StrongP@ssw0rd 
INFLUXDB_INITIAL_TOKEN="S3cr3TToK3nInFluxDB3=="
INFLUXDB_INITIAL_ORG=
INFLUXDB_INITIAL_BUCKET=

INFLUXDB_PLUGIN_DIR=/etc/influxdb/plugins