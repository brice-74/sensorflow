KAFKA_NODE_ID=1
# Roles of this Kafka process
KAFKA_PROCESS_ROLES=broker,controller
# Listener addresses
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
# How this node advertises itself to clients
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
# Controller quorum config (used in KRaft mode)
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
# Mapping of listener names to protocols
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
# Listener used for broker-to-broker communication
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
# Listener used by controller
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
# Kafka log data path
KAFKA_LOG_DIRS=/var/lib/kafka/data
KAFKA_AUTO_CREATE_TOPICS_ENABLE="true"
# Replication factor for internal offsets topic
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_HOURS=168
# Delay before starting group rebalance
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
# Unique cluster ID (for KRaft mode)
CLUSTER_ID="Np9XF7VHLq2uEaZBRTK5D1YmN"